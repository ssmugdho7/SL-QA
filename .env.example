BASE_URL=https://slshop.cloud
API_URL=https://api.slshop.cloud/api/v1
LOGIN_PHONE=
LOGIN_PASSWORD=
# Optional: password for the web app (any username). Leave empty for no login.
APP_PASSWORD=
PORT=4100

# ── Optional AI rewrites (src/engine/ai/providers.ts) ──────────────────────────
# Order: Claude (primary) → Gemini → Grok → the rest. A provider that fails is skipped and the next one is tried.
# Paid fallbacks (Grok, OpenAI, Cerebras) are used at most AI_PAID_DAILY_LIMIT times a day; Claude is not capped.
# Leave all empty to stay zero-AI. Several keys for one provider: separate with commas.

# Primary
ANTHROPIC_API_KEY=     # https://console.anthropic.com/settings/keys  (default model: claude-sonnet-5-5)

# Fallbacks, in order
GEMINI_API_KEY=        # https://aistudio.google.com/apikey  (free)
XAI_API_KEY=           # https://console.x.ai  (Grok, paid; GROK_API_KEY also works)
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys  (only ":free" models are used)
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys

# Paid (optional backup)
OPENAI_API_KEY=        # https://platform.openai.com/api-keys — also used by Super QA in the Assistant (not capped by AI_PAID_DAILY_LIMIT)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
AI_PAID_DAILY_LIMIT=20 # 0 = never use paid keys

# Optional: GitHub token for the Assistant's code context (private repos, higher rate limit). Read-only access is enough.
GITHUB_TOKEN=

# Live AI help during runs (on when any key is set). AI_LIVE=off keeps only the review page.
# AI_LIVE=on
# AI_MAX_CALLS_PER_CASE=12
# AI_MAX_SECONDS_PER_CASE=240   # total AI time per case
# AI_REPAIR_TRIES=2              # cap on Claude's corrected tries for a failed step (1 simple / 2 complex), then 1 fallback try
# AI_VISION=on                   # send a small screenshot to providers that read images (off = text only)

# Optional model overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# MISTRAL_MODEL=mistral-small-latest
# ANTHROPIC_MODEL=claude-sonnet-5-5
# XAI_MODEL=grok-4.5
# OPENAI_MODEL=gpt-4.1-mini
# Super QA (Assistant → Use Super QA): OpenAI model, then Claude if ANTHROPIC_API_KEY is set
SUPERQA_OPENAI_MODEL=gpt-5.4-mini
# CEREBRAS_MODEL=gpt-oss-120b
