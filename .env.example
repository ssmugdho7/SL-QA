BASE_URL=https://slshop.cloud
API_URL=https://api.slshop.cloud/api/v1
LOGIN_PHONE=
LOGIN_PASSWORD=
# Optional: password for the web app (any username). Leave empty for no login.
APP_PASSWORD=
PORT=4100

# Optional AI translator for sentences the bot does not understand (pick ONE; leave both empty for zero-AI).
# Anthropic: https://console.anthropic.com → API keys.  OpenAI: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: model override, e.g. claude-haiku-5-5 (cheaper) or gpt-4.1-mini
AI_MODEL=
